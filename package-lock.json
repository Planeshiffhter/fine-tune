{
  "name": "fine-tune",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fine-tune",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "services/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/builder-api": {
      "name": "@fine-tune/api",
      "version": "0.1.0",
      "dependencies": {
        "@fine-tune/core": "0.1.0"
      }
    },
    "apps/builder-web": {
      "name": "@fine-tune/web",
      "version": "0.1.0"
    },
    "node_modules/@fine-tune/agent": {
      "resolved": "services/agent-adapter",
      "link": true
    },
    "node_modules/@fine-tune/api": {
      "resolved": "apps/builder-api",
      "link": true
    },
    "node_modules/@fine-tune/core": {
      "resolved": "packages/project-generator",
      "link": true
    },
    "node_modules/@fine-tune/model-gateway": {
      "resolved": "services/model-gateway",
      "link": true
    },
    "node_modules/@fine-tune/web": {
      "resolved": "apps/builder-web",
      "link": true
    },
    "packages/project-generator": {
      "name": "@fine-tune/core",
      "version": "0.1.0"
    },
    "services/agent-adapter": {
      "name": "@fine-tune/agent",
      "version": "0.1.0"
    },
    "services/model-gateway": {
      "name": "@fine-tune/model-gateway",
      "version": "0.1.0"
    }
  }
}
