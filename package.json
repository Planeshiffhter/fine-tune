{
  "name": "fine-tune",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first mock application builder scaffold",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "node apps/builder-api/src/server.mjs",
    "start": "node apps/builder-api/src/server.mjs",
    "test": "node --test apps/builder-api/test/app.test.mjs packages/project-generator/test/core.test.mjs services/agent-adapter/test/agent.test.mjs services/model-gateway/test/model-gateway.test.mjs",
    "check": "npm test"
  }
}
